NODE_ENV=development
PORT=5000
DATABASE_URL="postgresql://username:password@localhost:5432/petfinder_db?schema=public"

# Comma-separated origins allowed by CORS (portal, admin, Expo web)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Number of proxies in front of the API (0 locally, 1 on Railway/Render)
TRUST_PROXY=0

# JWT
JWT_SECRET=change_me_access_secret
# Access token lifetime. The portal and app refresh it automatically, so keep it short.
EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=change_me_refresh_secret
REFRESH_TOKEN_EXPIRES_IN=30d

# Refresh cookie (defaults: lax in development, none+secure in production)
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# Password recovery
RESET_PASS_TOKEN=change_me_reset_secret
RESET_PASS_TOKEN_EXPIRES_IN=15m
RESET_PASS_LINK=http://localhost:3000/reset-password

# Email verification
EMAIL_VERIFY_LINK=http://localhost:3000/verify-email
EMAIL_VERIFY_TOKEN_EXPIRES_IN=1d

# SMTP (Nodemailer, Google app password)
EMAIL=your-email@gmail.com
APP_PASS=your-google-app-password

# Rate limiting (per IP)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# Cloudinary (signed server-side uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=petfinder

# Stripe (test mode keys until launch)
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
STRIPE_SUCCESS_URL=http://localhost:3000/dashboard/shelter/billing?status=success
STRIPE_CANCEL_URL=http://localhost:3000/dashboard/shelter/billing?status=cancelled
STRIPE_PORTAL_RETURN_URL=http://localhost:3000/dashboard/shelter/billing
SUBSCRIPTION_GRACE_DAYS=7
# Optional donation return pages (default: <first CORS origin>/donate?status=success|cancelled)
DONATION_SUCCESS_URL=
DONATION_CANCEL_URL=

# Google sign-in (OAuth client id used to verify ID tokens)
GOOGLE_CLIENT_ID=

# Seed accounts (npx prisma db seed). Passwords are required when NODE_ENV=production.
SEED_SUPER_ADMIN_EMAIL=superadmin@petfinder.test
SEED_SUPER_ADMIN_PASSWORD=change_me_super_admin
SEED_ADMIN_EMAIL=admin@petfinder.test
SEED_ADMIN_PASSWORD=change_me_admin
SEED_SHELTER_EMAIL=shelter@petfinder.test
SEED_SHELTER_PASSWORD=change_me_shelter
